# Copy this file to .env and fill in your own keys.
# NEVER commit .env to git. The .gitignore already excludes it.

# Anthropic API key — used by data/prepare_dataset.py to generate the
# synthetic Q&A dataset. Get one at https://console.anthropic.com/
# Cost guideline: generating 12K examples with claude-haiku-4-5 runs ~$5-15.
# IMPORTANT: set a monthly spending cap in the Anthropic Console BEFORE
# generating a key — that's the only thing that protects you from a leaked key.
ANTHROPIC_API_KEY=

# Hugging Face token — needed only if you push the trained adapter to the Hub.
# Get one at https://huggingface.co/settings/tokens (use a "write" token).
HF_TOKEN=

# Weights & Biases API key — for training run logging. Optional; pass
# `--no-wandb` to src/train.py to disable. Get one at https://wandb.ai/authorize
WANDB_API_KEY=

# Server configuration (defaults are fine for most use cases) -----------------

# Set USE_MOCK=true to run the FastAPI server without loading a model. Useful
# for CI, local frontend dev, and any environment without a GPU.
USE_MOCK=false

# Path to the trained LoRA adapter directory.
ADAPTER_PATH=artifacts/checkpoints/final

# Base model identifier (HuggingFace id).
BASE_MODEL=Qwen/Qwen2.5-7B-Instruct

# Whether to load the base model in 4-bit quantization at inference.
LOAD_IN_4BIT=true
