# ---- Secrets — NEVER commit ----
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets.json
credentials.json

# ---- Generated artifacts ----
artifacts/
# ...except evaluation results (small JSON + plot used in the README).
!artifacts/
!artifacts/results/
!artifacts/results/*.json
!artifacts/results/*.png
checkpoints/
wandb/
runs/
*.ckpt
*.bin
*.safetensors
*.pt
*.pth

# ---- Generated datasets ----
# We intentionally do NOT commit the full 12K-example dataset (too large; will
# be regenerated by each user with their own API key). The seed file IS
# committed (data/seed_topics.json). A tiny hand-crafted sample is committed
# under data/sample/ for tests and demos.
data/train.jsonl
data/val.jsonl
data/test.jsonl
data/raw_generated.jsonl

# ---- HuggingFace cache ----
.cache/
hub/
.huggingface/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Testing / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---- IDEs ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
